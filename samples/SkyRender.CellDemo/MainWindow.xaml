<Window x:Class="SkyRender.CellDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glWpf="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        Title="SkyRender Cell Demo" Width="1500" Height="950">
    <DockPanel Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Padding="8,4" Background="#F0F0F0" TextTrimming="CharacterEllipsis"
                   Text="Looking for the game..." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: choose a cell. -->
            <DockPanel Grid.Column="0" Margin="8">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontWeight="SemiBold">Data folder</TextBlock>
                    <DockPanel Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2" Click="BrowseData_Click"
                                ToolTip="Pick the game's Data folder if it was not found, or to use another one.">Browse…</Button>
                        <TextBox x:Name="DataFolderBox" IsReadOnly="True" VerticalContentAlignment="Center" Foreground="#505050"
                                 ToolTip="The game's Data folder. The load order is the game's own (plugins.txt)." />
                    </DockPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SelectedText" FontWeight="SemiBold" TextWrapping="Wrap" Text="No cell selected." />
                            <TextBlock x:Name="WinnerText" Foreground="#505050" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="LodBox" Margin="0,8,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                              ToolTip="Exteriors: draw the worldspace's distant terrain, objects, trees and water beyond the loaded cells. Adds load time.">Distant LOD (slower to load)</CheckBox>
                    <CheckBox x:Name="RingBox" Margin="0,4,0,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                              ToolTip="Exteriors: also load the eight cells around the selected one, as the game does around the player.">Neighbouring cells (3 × 3)</CheckBox>
                    <TextBlock Margin="0,8,0,0" Foreground="#606060" TextWrapping="Wrap">
                        Static objects only: NPCs and creatures are not drawn, and animations do not play.
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" Foreground="#606060" TextWrapping="Wrap">
                        Left-drag orbits, right-drag looks around, middle-drag pans, the wheel zooms.
                        Click the view, then W A S D to fly, Q / E down and up, Shift faster, Home to reset the view.
                    </TextBlock>
                </StackPanel>

                <TabControl x:Name="Tabs" Margin="0,8,0,0" SelectionChanged="Tabs_SelectionChanged">
                    <TabItem Header="Interiors">
                        <DockPanel Margin="4">
                            <TextBox x:Name="InteriorSearch" DockPanel.Dock="Top" TextChanged="InteriorSearch_TextChanged"
                                     ToolTip="Filter by EditorID or name." />
                            <TextBlock x:Name="InteriorCount" DockPanel.Dock="Top" Foreground="#606060" Margin="0,2" />
                            <ListBox x:Name="InteriorList" DisplayMemberPath="Display" SelectionChanged="CellList_SelectionChanged"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Exteriors">
                        <DockPanel Margin="4">
                            <ComboBox x:Name="WorldBox" DockPanel.Dock="Top" DisplayMemberPath="Display" SelectionChanged="WorldBox_SelectionChanged"
                                      ToolTip="The worldspace." />
                            <TextBox x:Name="ExteriorSearch" DockPanel.Dock="Top" Margin="0,4,0,0" TextChanged="ExteriorSearch_TextChanged"
                                     ToolTip="Filter by EditorID or name, or type grid coordinates as X,Y (for example 5,-11)." />
                            <TextBlock x:Name="ExteriorCount" DockPanel.Dock="Top" Foreground="#606060" Margin="0,2" />
                            <ListBox x:Name="ExteriorList" DisplayMemberPath="Display" SelectionChanged="CellList_SelectionChanged"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D0D0D0"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

            <!-- Right: the cell, and the log. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" MinHeight="160" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="60" />
                </Grid.RowDefinitions>

                <Grid x:Name="GlHost" Grid.Row="0" Background="#404040">
                    <glWpf:GLWpfControl x:Name="GlControl" Render="GlControl_Render" Focusable="True"
                                        MouseDown="GlControl_MouseDown" MouseMove="GlControl_MouseMove"
                                        MouseUp="GlControl_MouseUp" MouseWheel="GlControl_MouseWheel" KeyDown="GlControl_KeyDown" />
                </Grid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#D0D0D0"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

                <DockPanel Grid.Row="2">
                    <Border DockPanel.Dock="Top" Padding="8,3" Background="#F0F0F0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold">Log</TextBlock>
                            <CheckBox x:Name="VerboseBox" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                                      IsChecked="False" Checked="VerboseBox_Changed" Unchecked="VerboseBox_Changed"
                                      ToolTip="Include the renderer's detailed diagnostics (texture lookups, material decisions, timings). Slows loading.">Verbose</CheckBox>
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,1" Click="OpenLogFile_Click"
                                    ToolTip="Open the log file. It is written line by line, so it keeps the trail even if the window stops responding.">Open log file</Button>
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,1" Click="CopyLog_Click">Copy</Button>
                            <Button DockPanel.Dock="Right" Padding="8,1" Click="ClearLog_Click">Clear</Button>
                            <TextBlock x:Name="LogPathText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#606060"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" BorderThickness="0" />
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
