<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal viewer: pick a NIF, see it rendered with its textures. Uses only the core SkyRender
       package; the WPF parts here are the window and the GL control. Not packed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>SkyRender.Demo</RootNamespace>
    <AssemblyName>SkyRender.Demo</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SkyRender\SkyRender.csproj" />
    <!-- Hosts SkyRender's GL output in WPF. Same version SkyRender.Character uses. -->
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.3.3" />
    <!-- Reads the game's BSA archives (see FolderBsaProvider). Mutagen 0.54 needs net9+, hence the
         net10 target; the libraries themselves target net8.0. -->
    <PackageReference Include="Mutagen.Bethesda" Version="0.54.2" />
  </ItemGroup>
</Project>
