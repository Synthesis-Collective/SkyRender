<Window x:Class="SkyRender.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glWpf="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        Title="SkyRender Demo" Width="1000" Height="760">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8" Background="#F0F0F0">
            <DockPanel>
                <Button x:Name="OpenButton" DockPanel.Dock="Left" Padding="12,4" Click="OpenButton_Click">Open NIF…</Button>
                <TextBlock DockPanel.Dock="Left" Margin="16,0,6,0" VerticalAlignment="Center">Data folder:</TextBlock>
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,4" Click="BrowseData_Click">Browse…</Button>
                <TextBox x:Name="DataFolderBox" VerticalContentAlignment="Center"
                         ToolTip="The game's Data folder. Textures are resolved from its loose files and BSA archives. Filled in automatically when the NIF lies under a meshes folder." />
            </DockPanel>
        </Border>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Padding="8,4" Background="#F0F0F0"
                   Text="Open a .nif file. Left-drag to orbit, middle-drag to pan, wheel to zoom." />
        <Grid Background="#696969">
            <glWpf:GLWpfControl x:Name="GlControl" Render="GlControl_Render"
                                MouseDown="GlControl_MouseDown" MouseMove="GlControl_MouseMove"
                                MouseUp="GlControl_MouseUp" MouseWheel="GlControl_MouseWheel" />
        </Grid>
    </DockPanel>
</Window>
