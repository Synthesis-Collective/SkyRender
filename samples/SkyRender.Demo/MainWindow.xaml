<Window x:Class="SkyRender.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glWpf="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        Title="SkyRender Demo" Width="1000" Height="820">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8" Background="#F0F0F0">
            <DockPanel>
                <Button x:Name="OpenButton" DockPanel.Dock="Left" Padding="12,4" Click="OpenButton_Click">Open NIF…</Button>
                <TextBlock DockPanel.Dock="Left" Margin="16,0,6,0" VerticalAlignment="Center">Data folder:</TextBlock>
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,4" Click="BrowseData_Click">Browse…</Button>
                <TextBox x:Name="DataFolderBox" VerticalContentAlignment="Center"
                         ToolTip="The game's Data folder. Textures are resolved from its loose files and BSA archives. Filled in automatically when the NIF lies under a meshes folder." />
            </DockPanel>
        </Border>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Padding="8,4" Background="#F0F0F0"
                   Text="Open a .nif file. Left-drag to orbit, middle-drag to pan, wheel to zoom." />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="60" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#696969">
                <glWpf:GLWpfControl x:Name="GlControl" Render="GlControl_Render"
                                    MouseDown="GlControl_MouseDown" MouseMove="GlControl_MouseMove"
                                    MouseUp="GlControl_MouseUp" MouseWheel="GlControl_MouseWheel" />
            </Grid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#D0D0D0"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

            <DockPanel Grid.Row="2">
                <Border DockPanel.Dock="Top" Padding="8,3" Background="#F0F0F0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold">Log</TextBlock>
                        <CheckBox x:Name="VerboseBox" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                                  IsChecked="False" Checked="VerboseBox_Changed" Unchecked="VerboseBox_Changed"
                                  ToolTip="Include the renderer's detailed diagnostics (a full NIF block dump per load, texture lookups, material decisions, timings).">Verbose</CheckBox>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,1" Click="OpenLogFile_Click"
                                ToolTip="Open the log file. It is written line by line, so it keeps the trail even if the window stops responding.">Open log file</Button>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,1" Click="CopyLog_Click">Copy</Button>
                        <Button DockPanel.Dock="Right" Padding="8,1" Click="ClearLog_Click">Clear</Button>
                        <TextBlock x:Name="LogPathText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#606060"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" BorderThickness="0" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
