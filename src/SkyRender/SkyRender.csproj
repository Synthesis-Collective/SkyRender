<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core renderer: NIF parsing, materials and shaders, DDS textures, CPU skinning, the GL
       renderer and the offscreen pipeline. Plain net8.0: no WPF, ReactiveUI or weavers. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SkyRender</RootNamespace>
    <AssemblyName>SkyRender</AssemblyName>
    <PackageId>SkyRender</PackageId>
    <Product>SkyRender</Product>
    <Description>OpenGL renderer for Skyrim NIF scenes: NIF parsing, Bethesda materials and shaders, DDS textures, CPU skinning, offscreen PNG export.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The character tier forwards a few asset-cache internals (the DDS eligibility probe and the
       final-mip limit initializer) instead of making them public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SkyRender.Character" />
    <InternalsVisibleTo Include="SkyRender.Tests" />
    <InternalsVisibleTo Include="SkyRender.Core.Tests" />
    <!-- tools/NifSnapshot, the dev-only corpus harness, reads NIFs through NifAccess. -->
    <InternalsVisibleTo Include="NifSnapshot" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenGL bindings, maths and the GLFW window the offscreen renderer draws into. 4.8.2 is the
         version OpenTK.GLWpfControl 4.3.3 resolves, so the character tier sees one OpenTK. -->
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <!-- NIF reading: Nifly, ousnius's managed nifly (cross-platform). The minimum is 1.1.0-0, not
         1.1.0, so a host that builds its own 1.1.0 prerelease (houseCARL's 1.1.0-housecarl.N fork)
         keeps it: with ">= 1.1.0" NuGet silently swapped in upstream 1.1.0 from the package cache
         (docs/NIFLY_PORT_PLAN.md, Phase 0 results). That range is what NU1603 (1.1.0-0 itself
         does not exist) and NU5104 (a prerelease lower bound on a stable package) warn about. -->
    <PackageReference Include="Nifly" Version="1.1.0-0" NoWarn="NU1603;NU5104" />
    <PackageReference Include="Pfim" Version="0.11.4" />
  </ItemGroup>

  <!-- Shaders ship two ways: embedded into the assembly (so NuGet-package
       consumers — for whom copied content does NOT flow through a PackageReference
       — and single-file deployments still have them) AND copied next to the
       assembly (so local / ProjectReference builds can hot-edit a shader in the
       bin folder and re-run without a rebuild). ModuleResourceLocator.ReadShaderSource
       prefers the on-disk copy and falls back to the embedded one. -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.vert">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Shaders\*.frag">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
