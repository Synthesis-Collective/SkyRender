<Project>
  <!-- Shared version and package metadata for SkyRender and SkyRender.Character.
       Version: Major = breaking, Minor = additive, Patch = bugfix. SkyRenderInfo.Version reads the
       assembly version at runtime, so it always matches what is set here. -->
  <PropertyGroup>
    <Version>3.0.1</Version>
    <AssemblyVersion>3.0.1.0</AssemblyVersion>
    <FileVersion>3.0.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Map this repo's absolute paths to /_/ in every compiled path (PDB location, source
         paths), so a CI build embeds no local folder names. The WPF project's markup pass does
         not pick up ContinuousIntegrationBuild's mapping on its own.
         One path escapes it: Fody, which weaves SkyRender.Character after compilation, rewrites
         that DLL's debug directory with the absolute path of its PDB (Fody issue 1196). Release
         packages are therefore built by the release workflow, whose checkout folder names nothing
         local; a package built by hand should be built from a neutrally named folder. -->
    <PathMap Condition="'$(ContinuousIntegrationBuild)' == 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=/_/</PathMap>
  </PropertyGroup>

  <!-- NuGet packaging metadata. Produced with `dotnet pack -c Release`; not packed on every build. -->
  <PropertyGroup>
    <Authors>Piranha91, Synthesis Collective</Authors>
    <Company>Synthesis Collective</Company>
    <Copyright>Copyright (C) Synthesis Collective</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>skyrim;nif;opengl;renderer;offscreen</PackageTags>
    <PackageProjectUrl>https://github.com/Synthesis-Collective/SkyRender</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Synthesis-Collective/SkyRender</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- The licence text and the third-party notices travel with the package (the licence is also
         declared as an expression above). -->
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
