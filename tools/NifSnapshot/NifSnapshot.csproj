<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev-only harness for the niflysharp -> Nifly port (docs/NIFLY_PORT_PLAN.md): builds every mesh
       in a corpus through NifMeshBuilder and records a canonical hash of each BuiltMesh, so two
       builds of SkyRender can be compared file by file. Not in SkyRender.sln, not packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SkyRender.NifSnapshot</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SkyRender\SkyRender.csproj" />
    <!-- Reads the game's BSA archives, as the samples do. -->
    <PackageReference Include="Mutagen.Bethesda" Version="0.54.2" />
  </ItemGroup>
</Project>
