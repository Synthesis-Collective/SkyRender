<Project Sdk="Microsoft.NET.Sdk">

  <!-- The core library's tests on a plain TFM, so they also run on Linux (the ubuntu workflow):
       NIF fixtures are authored in the test with Nifly, so no game data is needed. The core test
       files of SkyRender.Tests are compiled in as well; InMemoryBsaAssetTests stays Windows-only
       because its archive paths use backslashes. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.0.0-alpha.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.8.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkyRender\SkyRender.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SkyRender.Tests\BillboardAndSceneDefaultsTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\SkyRender.Tests\DistanceFogTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\SkyRender.Tests\DistantLodTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\SkyRender.Tests\EffectMaterialTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\SkyRender.Tests\GrassTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\SkyRender.Tests\ImageSpaceFinishTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\SkyRender.Tests\PngWriterTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\SkyRender.Tests\ProjectedMaterialTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\SkyRender.Tests\ReferencePlacementTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\SkyRender.Tests\SkyGradientTests.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\SkyRender.Tests\WorldMeshBuilderTests.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
